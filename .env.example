# Copy this file to .env and fill in your values. Never commit .env.
# The app looks for .env in this folder first, then in the folder above it.

# Required: the course key (gpt-6-luna through Portkey).
PORTKEY_API_KEY=

# Optional: Plaid sandbox keys. Leave blank to use the sample bank data.
# Get them at https://dashboard.plaid.com/developers/keys (client_id + Sandbox secret).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional: override the Portkey gateway URL (defaults to https://api.portkey.ai/v1).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
