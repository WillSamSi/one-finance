# Copy this file to .env and fill in your values. Never commit .env.
# The app looks for .env in this folder first, then in the folder above it.

# Required: the course key (gpt-6-luna through Portkey).
PORTKEY_API_KEY=

# Optional: Plaid sandbox keys. Leave blank to use the sample bank data.
# Get them at https://dashboard.plaid.com/developers/keys (client_id + Sandbox secret).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional: leave blank to use the sample data. SnapTrade Personal API key (free) for the
# investment account; the app reads the fake "SANDBOX" brokerage connected to it.
# Get them at https://dashboard.snaptrade.com (API Key page). Backend only, never in the app.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Optional: who you are, for SEC EDGAR (company filings). The SEC requires a name and
# contact email on every request. Leave blank to use the saved company data in data/sample/sec/.
SEC_USER_AGENT=

# Optional: override the Portkey gateway URL (defaults to https://api.portkey.ai/v1).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
