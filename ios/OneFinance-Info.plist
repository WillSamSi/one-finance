<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app call the local backend at http://localhost:8000 during development. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- More → Privacy and security → Face ID lock. -->
	<key>NSFaceIDUsageDescription</key>
	<string>One Finance uses Face ID to lock your finances when the app opens.</string>
</dict>
</plist>
