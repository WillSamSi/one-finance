<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app call the local backend at http://localhost:8000 during development. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- More → Privacy and security → Face ID lock. -->
	<key>NSFaceIDUsageDescription</key>
	<string>One Finance uses Face ID to lock your finances when the app opens.</string>
	<!-- Static launch screen: the "One Finance" wordmark on Onyx. It's the same image pair the
	     splash animation starts from (scripts/make_brand_assets.swift), so the hand-off is seamless. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchWordmark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
